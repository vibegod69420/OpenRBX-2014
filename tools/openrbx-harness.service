[Unit]
Description=OpenRBX-2014 autonomous decompilation harness (DeepSeek V4.1 Flash + MSVC 11 under Wine)
After=network-online.target
Wants=network-online.target
# Never stop trying: the run is measured in weeks, and a transient API or Wine failure must
# not leave the worker dead until someone notices.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/openrbx/OpenRBX-2014
# The DeepAI key lives here, 0600 root-only; it is never part of the repository.
EnvironmentFile=-/etc/openrbx/deepai.env
Environment=DECOMP_BACKEND=deepai
Environment=DEEPAI_MODEL=deepseek-v4.1-flash
Environment=DEEPAI_REASONING_EFFORT=max
Environment=DEEPAI_ENV_FILE=/etc/openrbx/deepai.env
Environment=DECOMP_MAX_TOKENS=98304
# Set to 1 once a git credential is installed for root and progress should publish itself.
Environment=DECOMP_PUSH=0
Environment=MSVC_BIN_DIR=/opt/msvc110/bin
Environment=MSVC_ROOT=/opt/msvc110
Environment=WINEPREFIX=/opt/msvc110/wineprefix
Environment=WINEDEBUG=-all
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
ExecStartPre=/bin/mkdir -p /var/log/openrbx
ExecStart=/usr/bin/python3 /opt/openrbx/OpenRBX-2014/tools/autonomous_harness.py
Restart=always
RestartSec=10
# SIGINT reaches the harness's KeyboardInterrupt handler, which logs the stop and lets an
# in-flight batch finish its bookkeeping instead of being killed mid-write.
KillSignal=SIGINT
TimeoutStopSec=90
StandardOutput=append:/var/log/openrbx/harness.log
StandardError=append:/var/log/openrbx/harness.log

[Install]
WantedBy=multi-user.target
